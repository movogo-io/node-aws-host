{
  "name": "@riddance/aws-host",
  "version": "0.2.1",
  "type": "module",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/movogo-io/node-aws-host.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "keywords": [
    "riddance",
    "serverless",
    "environment",
    "devops",
    "aws",
    "opinionated"
  ],
  "files": [
    "*.js",
    "lib/*.js"
  ],
  "exports": {
    "./context": "./context.js",
    "./http": "./http.js",
    "./timer": "./timer.js",
    "./event": "./event.js"
  },
  "dependencies": {
    "@riddance/service": "0.3.1",
    "@riddance/host": "0.3.1",
    "@riddance/fetch": "0.1.5",
    "@smithy/signature-v4": "5.6.12"
  },
  "devDependencies": {
    "@riddance/env": "0.10.2"
  },
  "allowScripts": {
    "@riddance/env": true
  },
  "scripts": {
    "start": "riddance-watch",
    "prepack": "riddance-build",
    "prepublishOnly": "riddance-prepublish",
    "postpublish": "riddance-sync"
  }
}
